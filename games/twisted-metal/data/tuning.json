  "ram_layout": {
    "notes": "PS1 addresses. Vehicle struct base = address of world x minus 0x388 (decode agent convention): player 0x801A179C, first opponent 0x801A21C0. Player and AI structs do not share every offset (health is at base+0x178 for the player, base+0x190 for AI), so both are listed with absolute addresses. Further AI cars repeat every 0x560 bytes (health at 0x801A2350, 0x801A28B0, 0x801A2E10, ...).",
    "player": {
      "world_x": "0x801A1B24 i32 (+0x388)",
      "world_y": "0x801A1B28 i32 (+0x38C)",
      "world_z": "0x801A1B2C i32 (+0x390)",
      "heading": "0x801A1B44 i32 (+0x3A8), 4096/turn, unwrapped; direction of travel = (sin, cos) of heading; LEFT lowers it",
      "speed": "0x801A1B34 i32, 1/32 world unit per tick, negative in reverse",
      "accel_this_tick": "0x801A182C i32",
      "health": "0x801A1914 i32",
      "max_health": "0x801A1918 i32",
      "params_block": "0x801A1908..0x801A19F4 (per-vehicle constants: +0x26c hp, +0x2d0 from-rest accel, +0x2d4 top speed raw, +0x2d8 turbo accel, +0x314 handbrake turn multiplier; other entries unidentified)",
      "turbo_frames_left_in_tank": "0x801A19CC i32 (180 per tank, -1 per frame while boosting)",
      "turbo_spare_tanks": "0x801A1C3A i16",
      "selected_weapon": "0x801A1BFC i16 (0-10 pickups, 11 special)",
      "ammo": "0x801A1C00 + 2*index, i16 (index 11 = special energy at 0x801A1C16)",
      "special_regen_counter": "0x801A1C2E i16, counts 0..80 ticks",
      "weapon_refire_timer": "0x801A1BF6 i16 (counts down per tick from 20)",
      "mg_shot_timer": "0x801A1BF4 i16 (3..0)",
      "gun_temperature": "0x801A1C2A i16 (0..~204)",
      "placed_object_record": "0x8019171C + n*0x10C: heading +0x58, x/y/z +0x5C/+0x60/+0x64 (record index differs per vehicle)"
    },
